{
	"name": "@bopstack/oxc",
	"version": "0.1.0",
	"description": "Oxlint plugin for Bopstack project conventions — naming, inline styles, colors, test extensions, empty catches, and ts-ignore.",
	"keywords": [
		"bopstack",
		"javascript",
		"lint",
		"naming-convention",
		"oxc",
		"oxlint",
		"typescript"
	],
	"homepage": "https://github.com/bopstack/oxc#readme",
	"bugs": {
		"url": "https://github.com/bopstack/oxc/issues"
	},
	"license": "MIT",
	"author": "BopStack",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bopstack/oxc.git"
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"type": "module",
	"main": "dist/index.js",
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@commitlint/types": "^21.0.1",
		"@effect/vitest": "4.0.0-beta.70",
		"@oxlint/plugins": "^1.66.0",
		"effect": "4.0.0-beta.70",
		"effect-oxlint": "0.2.0",
		"oxfmt": "^0.52.0",
		"oxlint": "^1.67.0",
		"rolldown": "^1.0.3",
		"secretlint": "^13.0.2",
		"vitest": "^4.1.7"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
